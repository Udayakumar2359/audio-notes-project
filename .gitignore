# AudioNotes AI - Gitignore

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/
*.egg-info/
dist/
build/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
!.env.example

# ── Database files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
local_dev.db

# ── Uploaded user audio / video files (large binary blobs) ───────────────────
backend/uploads/
uploads/
*.mp3
*.wav
*.webm
*.m4a
*.ogg
*.flac
*_raw.wav
*_chunks/

# ── ML model weights & training artefacts ────────────────────────────────────
models/
local_cache/
*.pt
*.pth
*.bin
*.onnx
wandb/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.production
frontend_redesign/node_modules/
frontend_redesign/dist/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temporary / cache dirs ────────────────────────────────────────────────────
.cache/
temp/
tmp/
.tmp/

# ── Agent / AI tool state ─────────────────────────────────────────────────────
.agent/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Build / coverage artefacts ───────────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Docs (local reports, notes, internal documentation) ──────────────────────
docs/

# ── Local dev server starters ─────────────────────────────────────────────────
start_servers.bat
*.bat
