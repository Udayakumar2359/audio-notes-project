<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="db-design" name="Database Design">
    <mxGraphModel dx="1873" dy="1105" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1350" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=24;fontColor=#1a237e;" value="AUDIONOTES AI — DATABASE DESIGN" vertex="1">
          <mxGeometry height="50" width="1200" x="227" y="16" as="geometry" />
        </mxCell>
        <mxCell id="grp_auth" parent="1" style="swimlane;startSize=40;fillColor=#e3f2fd;strokeColor=#1565c0;html=1;fontSize=16;fontStyle=1;fontColor=#1565c0;" value="👤 AUTH &amp; USER DOMAIN" vertex="1">
          <mxGeometry height="380" width="550" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tbl_users" parent="grp_auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;    google_id : VARCHAR(120) UNIQUE&lt;br&gt;    name : VARCHAR(100)&lt;br&gt;    email : VARCHAR(200) UNIQUE&lt;br&gt;    hashed_password : VARCHAR(300)&lt;br&gt;    otp_code : VARCHAR(10)&lt;br&gt;    otp_expires_at : DATETIME&lt;br&gt;    is_verified : BOOLEAN&lt;br&gt;    created_at : DATETIME" vertex="1">
          <mxGeometry height="220" width="240" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="note_auth" parent="grp_auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=13;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Design Notes:&lt;/b&gt;&lt;br&gt;• Dual auth: Google OAuth + local&lt;br&gt;• bcrypt hash for passwords&lt;br&gt;• OTP for email verification&lt;br&gt;• google_id nullable (local users)&lt;br&gt;• hashed_pw nullable (OAuth users)&lt;br&gt;• JWT tokens issued on login" vertex="1">
          <mxGeometry height="170" width="255" x="280" y="55" as="geometry" />
        </mxCell>
        <mxCell id="idx_users" parent="grp_auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=13;align=left;spacingLeft=8;" value="&lt;b&gt;Indexes:&lt;/b&gt; email, google_id, id" vertex="1">
          <mxGeometry height="35" width="255" x="280" y="238" as="geometry" />
        </mxCell>
        <mxCell id="cs_users" parent="grp_auth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=13;align=left;spacingLeft=8;" value="&lt;b&gt;Constraints:&lt;/b&gt; email UNIQUE, google_id UNIQUE" vertex="1">
          <mxGeometry height="35" width="255" x="280" y="282" as="geometry" />
        </mxCell>
        <mxCell id="grp_audio" parent="1" style="swimlane;startSize=40;fillColor=#e8f5e9;strokeColor=#1b5e20;html=1;fontSize=16;fontStyle=1;fontColor=#1b5e20;" value="🎙 AUDIO PROCESSING DOMAIN" vertex="1">
          <mxGeometry height="380" width="740" x="700" y="80" as="geometry" />
        </mxCell>
        <mxCell id="tbl_af" parent="grp_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;audio_files&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  user_id → users.id&lt;br&gt;    filename : VARCHAR(300)&lt;br&gt;    file_path : VARCHAR(500) NULL&lt;br&gt;    duration_seconds : FLOAT&lt;br&gt;    status : VARCHAR(200)&lt;br&gt;    created_at : DATETIME" vertex="1">
          <mxGeometry height="195" width="220" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_ac" parent="grp_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;audio_chunks&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  audio_file_id → af.id&lt;br&gt;    chunk_index : INTEGER&lt;br&gt;    start_time : FLOAT&lt;br&gt;    end_time : FLOAT&lt;br&gt;    chunk_path : VARCHAR(500)" vertex="1">
          <mxGeometry height="180" width="220" x="255" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_tr" parent="grp_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;transcriptions&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  chunk_id → chunk.id (1:1)&lt;br&gt;    raw_text : TEXT&lt;br&gt;    cleaned_text : TEXT&lt;br&gt;    detected_language : VARCHAR(10)&lt;br&gt;    translated_text : TEXT (en)" vertex="1">
          <mxGeometry height="185" width="230" x="490" y="55" as="geometry" />
        </mxCell>
        <mxCell id="note_audio" parent="grp_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=13;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Design Notes:&lt;/b&gt;&lt;br&gt;• file_path set NULL after processing&lt;br&gt;• status: uploaded→chunking→transcribing&lt;br&gt;  →structuring→done|failed:…&lt;br&gt;• 1 chunk → 1 transcription (1:1)&lt;br&gt;• 25s chunks, Whisper ASR&lt;br&gt;• CASCADE delete: audio→chunks→transcriptions" vertex="1">
          <mxGeometry height="145" width="460" x="20" y="270" as="geometry" />
        </mxCell>
        <mxCell id="cascade_note" parent="grp_audio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=13;align=left;spacingLeft=8;" value="&lt;b&gt;Cascade:&lt;/b&gt; audio_files DELETE → chunks, transcriptions, structured_notes, shared_notes, group_notes" vertex="1">
          <mxGeometry height="40" width="460" x="265" y="320" as="geometry" />
        </mxCell>
        <mxCell id="grp_notes" parent="1" style="swimlane;startSize=40;fillColor=#f3e5f5;strokeColor=#6a1b9a;html=1;fontSize=16;fontStyle=1;fontColor=#6a1b9a;" value="📝 NOTES &amp; SHARING DOMAIN" vertex="1">
          <mxGeometry height="330" width="740" x="80" y="560" as="geometry" />
        </mxCell>
        <mxCell id="tbl_sn" parent="grp_notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;structured_notes&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  audio_file_id → af.id&lt;br&gt;    notes_text : TEXT (plain)&lt;br&gt;    notes_json : TEXT (JSON)&lt;br&gt;    notes_edited_text : TEXT&lt;br&gt;    embedding_json : TEXT (384-dim)&lt;br&gt;    credibility_json : TEXT (JSON)&lt;br&gt;    word_count : INTEGER&lt;br&gt;    created_at : DATETIME" vertex="1">
          <mxGeometry height="250" width="250" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_sh" parent="grp_notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;shared_notes&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  audio_file_id → af.id&lt;br&gt;FK  created_by → users.id&lt;br&gt;    token : VARCHAR(64) UNIQUE&lt;br&gt;    expires_at : DATETIME NULL&lt;br&gt;    view_count : INTEGER&lt;br&gt;    created_at : DATETIME" vertex="1">
          <mxGeometry height="215" width="230" x="285" y="55" as="geometry" />
        </mxCell>
        <mxCell id="note_notes" parent="grp_notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=13;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Design Notes:&lt;/b&gt;&lt;br&gt;• notes_json stores full Qwen output&lt;br&gt;• embedding_json: 384-dim float array&lt;br&gt;• credibility_json: ROUGE + groundedness&lt;br&gt;• token = secure random 64-char string&lt;br&gt;• expires_at=NULL means never expires&lt;br&gt;• view_count tracked for analytics" vertex="1">
          <mxGeometry height="175" width="200" x="530" y="55" as="geometry" />
        </mxCell>
        <mxCell id="grp_collab" parent="1" style="swimlane;startSize=40;fillColor=#e8f5e9;strokeColor=#2e7d32;html=1;fontSize=16;fontStyle=1;fontColor=#2e7d32;" value="👥 COLLABORATION DOMAIN" vertex="1">
          <mxGeometry height="330" width="740" x="900" y="560" as="geometry" />
        </mxCell>
        <mxCell id="tbl_sg" parent="grp_collab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;study_groups&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  owner_id → users.id&lt;br&gt;    name : VARCHAR(120)&lt;br&gt;    description : TEXT&lt;br&gt;    invite_code : VARCHAR(12) UNIQUE&lt;br&gt;    created_at : DATETIME" vertex="1">
          <mxGeometry height="195" width="220" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_gm" parent="grp_collab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;group_members&lt;/b&gt;&lt;br&gt;──────────────────────&lt;br&gt;PK  id : INTEGER&lt;br&gt;FK  group_id → sg.id&lt;br&gt;FK  user_id → users.id&lt;br&gt;    role : VARCHAR(20)&lt;br&gt;    joined_at : DATETIME&lt;br&gt;UNIQUE(group_id, user_id)" vertex="1">
          <mxGeometry height="195" width="215" x="255" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_gn2" parent="grp_collab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;" value="&lt;b&gt;group_notes&lt;/b&gt;&lt;br&gt;PK id · FK group_id&lt;br&gt;FK audio_file_id · FK added_by&lt;br&gt;added_at : DATETIME" vertex="1">
          <mxGeometry height="100" width="220" x="490" y="55" as="geometry" />
        </mxCell>
        <mxCell id="tbl_gf2" parent="grp_collab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;" value="&lt;b&gt;group_files&lt;/b&gt;&lt;br&gt;PK id · FK group_id&lt;br&gt;FK uploaded_by · filename&lt;br&gt;file_type · file_size" vertex="1">
          <mxGeometry height="100" width="220" x="490" y="165" as="geometry" />
        </mxCell>
        <mxCell id="cd1" edge="1" parent="1" source="grp_auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1a237e;strokeWidth=2;fontSize=13;fontStyle=1;dashed=1;" target="grp_audio" value="user_id FK">
          <mxGeometry relative="1" as="geometry" />
