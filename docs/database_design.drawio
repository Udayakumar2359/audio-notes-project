        <mxCell id="db_tables_summary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#558b2f;fontSize=14;align=left;spacingLeft=12;verticalAlign=top;" value="&lt;b&gt;ALL TABLES (11 total)&lt;/b&gt;&lt;br&gt;&lt;br&gt;users · audio_files · audio_chunks · transcriptions&lt;br&gt;structured_notes · shared_notes · study_groups&lt;br&gt;group_members · group_notes · group_files · group_chat_messages" vertex="1">
          <mxGeometry height="110" width="530" x="720" y="960" as="geometry" />
        </mxCell>
        <mxCell id="note_collab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=13;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Design:&lt;/b&gt;&lt;br&gt;• UNIQUE(group_id, user_id) prevents&lt;br&gt;  duplicate memberships&lt;br&gt;• invite_code 12-char random join key&lt;br&gt;• role: &#39;owner&#39; | &#39;member&#39;&lt;br&gt;• CASCADE group → members, notes,&lt;br&gt;  files, messages" vertex="1">
          <mxGeometry height="155" width="200" x="1400" y="830" as="geometry" />
