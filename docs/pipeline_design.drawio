        <mxCell id="p2_calc" parent="lane_chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=14;" value="Compute N chunks&lt;br&gt;{index, start, end, path}&lt;br&gt;for each chunk" vertex="1">
