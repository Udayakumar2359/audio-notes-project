        <mxCell id="p3_sched" parent="lane_trans" style="hexagon;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" value="GLOBAL&lt;br&gt;ThreadPoolExecutor&lt;br&gt;MAX_WORKERS=12" vertex="1">
          <mxGeometry height="90" width="220" x="20" y="50" as="geometry" />
