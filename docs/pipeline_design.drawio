          <mxGeometry height="50" width="1300" x="177" y="16" as="geometry" />
        </mxCell>

        <!-- ══ STAGE 0: INGEST ══ -->
        <mxCell id="lane_ingest" parent="1" style="swimlane;startSize=40;fillColor=#e3f2fd;strokeColor=#1565c0;html=1;fontSize=16;fontStyle=1;fontColor=#1565c0;" value="STAGE 0 — INGEST" vertex="1">
