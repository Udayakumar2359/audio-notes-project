        <mxCell id="p2_dir" parent="lane_chunk" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="_chunks/ dir&lt;br&gt;chunk_0.wav&lt;br&gt;chunk_N.wav" vertex="1">
          <mxGeometry height="90" width="185" x="270" y="50" as="geometry" />
