        <mxCell id="p3_nr" parent="lane_trans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=14;" value="Per-Worker:&lt;br&gt;• Load WAV (soundfile)&lt;br&gt;• librosa.trim silence&lt;br&gt;• noisereduce 0.75" vertex="1">
          <mxGeometry height="100" width="200" x="260" y="40" as="geometry" />
