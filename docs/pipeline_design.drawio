        <mxCell id="p0_save" parent="lane_ingest" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=14;" value="Save to /uploads/&lt;br&gt;Record audio_file&lt;br&gt;status=uploaded" vertex="1">
          <mxGeometry height="100" width="195" x="410" y="40" as="geometry" />
        </mxCell>

        <mxCell id="p0_bg" parent="lane_ingest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" value="FastAPI&lt;br&gt;BackgroundTask&lt;br&gt;→ spawn thread" vertex="1">
          <mxGeometry height="90" width="175" x="625" y="50" as="geometry" />
        </mxCell>

        <mxCell id="p0_resp" parent="lane_ingest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" value="Immediate 202&lt;br&gt;Response to User&lt;br&gt;(non-blocking)" vertex="1">
          <mxGeometry height="90" width="175" x="820" y="50" as="geometry" />
        </mxCell>

        <!-- ══ STAGE 1: CONVERT ══ -->
        <mxCell id="lane_convert" parent="1" style="swimlane;startSize=40;fillColor=#e8f5e9;strokeColor=#2e7d32;html=1;fontSize=16;fontStyle=1;fontColor=#2e7d32;" value="STAGE 1 — CONVERT (status: converting)" vertex="1">
          <mxGeometry height="180" width="1490" x="80" y="330" as="geometry" />
        </mxCell>

        <mxCell id="p1_conv" parent="lane_convert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14;" value="ffmpeg Convert&lt;br&gt;Any format → WAV&lt;br&gt;16kHz mono float32" vertex="1">
          <mxGeometry height="90" width="200" x="20" y="50" as="geometry" />
        </mxCell>

        <mxCell id="p1_raw" parent="lane_convert" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14;" value="_raw.wav&lt;br&gt;(temp file)" vertex="1">
          <mxGeometry height="90" width="175" x="240" y="50" as="geometry" />
        </mxCell>

        <mxCell id="p1_note" parent="lane_convert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;fontSize=14;" value="Output duration_seconds&lt;br&gt;Audio metadata&lt;br&gt;DB updated" vertex="1">
