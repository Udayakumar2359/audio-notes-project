        <!-- Pipeline summary banner -->
        <mxCell id="summary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=14;align=left;spacingLeft=14;verticalAlign=top;" value="&lt;b&gt;PIPELINE SUMMARY&lt;/b&gt;&lt;br&gt;Target: ≤ 150s for 90-minute audio on CPU-only&lt;br&gt;Stage 3 is the bottleneck: parallelised with ThreadPoolExecutor (up to 12 workers)&lt;br&gt;Stage 5 is the second bottleneck: Qwen inference (~2-5 min on CPU, ~20s on GPU)&lt;br&gt;All intermediate files (_raw.wav, _chunks/) are deleted on success to save disk space" vertex="1">
