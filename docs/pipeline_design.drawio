        <mxCell id="p0_upload" parent="lane_ingest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" value="User Uploads&lt;br&gt;Audio File&lt;br&gt;(MP3/WAV/M4A)" vertex="1">
          <mxGeometry height="90" width="175" x="20" y="50" as="geometry" />
