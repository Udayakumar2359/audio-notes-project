        <!-- ══ STAGE 2: CHUNK ══ -->
        <mxCell id="lane_chunk" parent="1" style="swimlane;startSize=40;fillColor=#fff8e1;strokeColor=#f9a825;html=1;fontSize=16;fontStyle=1;fontColor=#e65100;" value="STAGE 2 — CHUNK (status: chunking)" vertex="1">
          <mxGeometry height="180" width="1490" x="80" y="580" as="geometry" />
        </mxCell>

        <mxCell id="p2_chunk" parent="lane_chunk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="pydub AudioSegment&lt;br&gt;Split every CHUNK_SECS=25s&lt;br&gt;Export as WAV chunks" vertex="1">
          <mxGeometry height="90" width="230" x="20" y="50" as="geometry" />
